            {
                "command": "gpl.ai.debugAssist",
                "title": "GPL: AI Debug Assist",
                "icon": "$(hubot)"
            },
            {
                "command": "gpl.ai.debug.getState",
                "title": "GPL: AI Debug Get State"
            },
            {
                "command": "gpl.ai.debug.setBreakpoint",
                "title": "GPL: AI Debug Set Breakpoint"
            },
            {
                "command": "gpl.ai.debug.clearBreakpoint",
