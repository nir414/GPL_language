        "esbuild": "^0.28.1",
        "typescript": "^4.9.4"
    },
    "dependencies": {
        "@vscode/debugadapter": "^1.68.0",
        "@vscode/debugprotocol": "^1.68.0",
        "basic-ftp": "^5.3.0"
