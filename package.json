        "keybindings": [
            {
                "command": "workbench.action.debug.continue",
                "key": "f9",
                "when": "inDebugMode && debugType == 'brooks-gpl'"
            },
            {
                "command": "editor.debug.action.showDebugHover",
                "key": "ctrl+alt+i",
                "when": "inDebugMode && editorTextFocus && editorLangId == 'gpl'"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "gpl-controller",
                    "title": "GPL Controller",
                    "icon": "resources/gpl-controller.svg"
                }
            ]
        },
        "views": {
            "gpl-controller": [
                {
                    "id": "gplThreads",
                    "name": "Status",
                    "icon": "resources/gpl-controller.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "gpl.controller.connect",
                    "when": "view == gplThreads && !gpl.ui.connected",
                    "group": "navigation@1"
                },
                {
                    "command": "gpl.controller.stopAll",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "navigation@1"
                },
                {
                    "command": "gpl.threads.refresh",
                    "when": "view == gplThreads",
                    "group": "2_tools@1"
                },
                {
                    "command": "gpl.deploy",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "1_deploy@0"
                },
                {
                    "command": "gpl.start",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "navigation@3"
                },
                {
                    "command": "gpl.quickCompile",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "navigation@2"
                },
                {
                    "command": "gpl.saveToFlash",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "1_deploy@1"
                },
                {
                    "command": "gpl.diagnosticSnapshot",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "3_diag@1"
                },
                {
                    "command": "gpl.ai.debugAssist",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "3_diag@2"
                },
                {
                    "command": "gpl.controller.showTraffic",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "3_diag@3"
                },
                {
                    "command": "gpl.controller.sendCommand",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "2_tools@2"
                },
                {
                    "command": "gpl.controller.copySituationForChat",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "2_tools@3"
                },
                {
                    "command": "gpl.debug.attachNow",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "2_debug@1"
                },
                {
                    "command": "gpl.debug.generateLaunch",
                    "when": "view == gplThreads",
                    "group": "2_debug@2"
                },
                {
                    "command": "gpl.controller.pushBreakpoints",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "2_debug@3"
                },
                {
                    "command": "gpl.controller.pullBreakpoints",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "2_debug@4"
                },
                {
                    "command": "gpl.console.start",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "3_console@1"
                },
                {
                    "command": "gpl.console.stop",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "3_console@2"
                },
                {
                    "command": "gpl.logs.liveTerminal.start",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "3_console@3"
                },
                {
                    "command": "gpl.logs.liveTerminal.stop",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "3_console@4"
                },
                {
                    "command": "gpl.ai.exportAgentSetup",
                    "when": "view == gplThreads",
                    "group": "3_diag@4"
                },
                {
                    "command": "gpl.controller.disconnect",
                    "when": "view == gplThreads && gpl.ui.connected",
                    "group": "9_connection@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "gpl.controller.refreshBreakpoints",
                    "when": "view == gplThreads && viewItem == section-breakpoints",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.showTraffic",
                    "when": "view == gplThreads && viewItem == runtimeConsoleItem",
                    "group": "inline"
                },
                {
                    "command": "gpl.console.stop",
                    "when": "view == gplThreads && viewItem == runtimeConsoleItem",
                    "group": "runtimeConsole@1"
                },
                {
                    "command": "gpl.controller.threadStart",
                    "when": "view == gplThreads && viewItem == gplThread-stopped",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.threadStop",
                    "when": "view == gplThreads && viewItem == gplThread-running",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.threadBreak",
                    "when": "view == gplThreads && viewItem == gplThread-running",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.threadContinue",
                    "when": "view == gplThreads && viewItem == gplThread-paused",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.threadStep",
                    "when": "view == gplThreads && viewItem == gplThread-paused",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.threadContinueNoError",
                    "when": "view == gplThreads && viewItem == gplThread-error",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.threadStart",
                    "when": "view == gplThreads && viewItem == gplThread-stopped",
                    "group": "thread@1"
                },
                {
                    "command": "gpl.controller.threadStop",
                    "when": "view == gplThreads && viewItem == gplThread-running",
                    "group": "thread@1"
                },
                {
                    "command": "gpl.controller.threadBreak",
                    "when": "view == gplThreads && viewItem == gplThread-running",
                    "group": "thread@2"
                },
                {
                    "command": "gpl.controller.threadContinue",
                    "when": "view == gplThreads && viewItem == gplThread-paused",
                    "group": "thread@1"
                },
                {
                    "command": "gpl.controller.threadStep",
                    "when": "view == gplThreads && viewItem == gplThread-paused",
                    "group": "thread@2"
                },
                {
                    "command": "gpl.controller.threadStop",
                    "when": "view == gplThreads && viewItem == gplThread-paused",
                    "group": "thread@3"
                },
                {
                    "command": "gpl.controller.threadContinueNoError",
                    "when": "view == gplThreads && viewItem == gplThread-error",
                    "group": "thread@1"
                },
                {
                    "command": "gpl.controller.threadStop",
                    "when": "view == gplThreads && viewItem == gplThread-error",
                    "group": "thread@2"
                },
                {
                    "command": "gpl.threads.refresh",
                    "when": "view == gplThreads && viewItem == section-threads",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.stopAll",
                    "when": "view == gplThreads && viewItem == section-threads",
                    "group": "inline"
                },
                {
                    "command": "gpl.deploy",
                    "when": "view == gplThreads && viewItem == section-threads",
                    "group": "threadSection@1"
                },
                {
                    "command": "gpl.start",
                    "when": "view == gplThreads && viewItem == section-threads",
                    "group": "threadSection@2"
                },
                {
                    "command": "gpl.saveToFlash",
                    "when": "view == gplThreads && viewItem == section-threads",
                    "group": "threadSection@3"
                },
                {
                    "command": "gpl.diagnosticSnapshot",
                    "when": "view == gplThreads && viewItem == section-threads",
                    "group": "threadSection@4"
                },
                {
                    "command": "gpl.controller.refreshFtp",
                    "when": "view == gplThreads && viewItem == section-ftp",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.refreshFtp",
                    "when": "view == gplThreads && viewItem == section-ftpFlash",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.refreshSystemInfo",
                    "when": "view == gplThreads && viewItem == section-system",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.clearErrors",
                    "when": "view == gplThreads && (viewItem == section-errorsCode || viewItem == section-errorsEnv)",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.copyError",
                    "when": "view == gplThreads && viewItem == errorItem",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.copyError",
                    "when": "view == gplThreads && viewItem == errorItem",
                    "group": "error@1"
                },
                {
                    "command": "gpl.controller.ftpRun",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFlashFolder/",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.ftpStop",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFlashFolder/",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.ftpDownload",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFlashFolder/",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.ftpDelete",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFile|ftpFlashFolder|ftpFlashFile/",
                    "group": "inline"
                },
                {
                    "command": "gpl.controller.ftpRun",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFlashFolder/",
                    "group": "ftp@1"
                },
                {
                    "command": "gpl.controller.ftpStop",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFlashFolder/",
                    "group": "ftp@2"
                },
                {
                    "command": "gpl.controller.ftpDelete",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFile|ftpFlashFolder|ftpFlashFile/",
                    "group": "ftp@3"
                },
                {
                    "command": "gpl.controller.ftpUnload",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFlashFolder/",
                    "group": "ftp@4"
                },
                {
                    "command": "gpl.controller.ftpDownload",
                    "when": "view == gplThreads && viewItem =~ /ftpFolder|ftpFlashFolder/",
                    "group": "ftp@5"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "GPL Language Support",
            "properties": {
                "gpl.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Controls GPL Language Support extension tracing (Output: 'GPL Language Support')."
                },
                "gpl.trace.liveTerminal.autoStart": {
                    "scope": "window",
                    "type": "boolean",
                    "default": false,
                    "description": "Auto-start GPL Live Logs terminal when the extension activates."
                },
                "gpl.runtimeConsole.autoStartOnDeploy": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Auto-start runtime console (port 1403) after successful deploy."
                },
                "gpl.runtimeConsole.autoStartOnDebug": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Auto-start runtime console (port 1403) when a brooks-gpl debug session starts."
                },
                "gpl.runtimeConsole.showStateInOutputChannel": {
                    "scope": "window",
                    "type": "boolean",
                    "default": false,
                    "description": "Mirror RC1403 state logs (CONNECTED/DISCONNECTED/no_payload) to output channels. Keep false to show payload-only logs in GPL Console."
                },
                "gpl.runtimeConsole.noPayloadWarnThreshold": {
                    "scope": "window",
                    "type": "number",
                    "default": 10,
                    "description": "Consecutive anomalous no-payload attempts before 1403 unstable warning is shown. Immediate EOF polling is treated separately."
                },
                "gpl.runtimeConsole.unstableWarnCooldownMs": {
                    "scope": "window",
                    "type": "number",
                    "default": 60000,
                    "description": "Cooldown for repeated 1403 unstable warnings in milliseconds."
                },
                "gpl.runtimeConsole.emptyNoticeEvery": {
                    "scope": "window",
                    "type": "number",
                    "default": 5,
                    "description": "For repeated no-payload or empty-poll sessions, print detailed console notices every N attempts."
                },
                "gpl.runtimeConsole.immediateEofReconnectBaseMs": {
                    "scope": "window",
                    "type": "number",
                    "default": 1000,
                    "description": "Base polling delay for 1403 sessions that close immediately without payload because the event queue is empty (Immediate EOF)."
                },
                "gpl.runtimeConsole.immediateEofReconnectMaxMs": {
                    "scope": "window",
                    "type": "number",
                    "default": 15000,
                    "description": "Maximum polling delay for repeated Immediate EOF 1403 sessions."
                },
                "gpl.runtimeConsole.idleReconnectBaseMs": {
                    "scope": "window",
                    "type": "number",
                    "default": 5000,
                    "description": "Base reconnect delay for idle/no-payload 1403 sessions (adaptive)."
                },
                "gpl.runtimeConsole.idleReconnectMaxMs": {
                    "scope": "window",
                    "type": "number",
                    "default": 30000,
                    "description": "Maximum reconnect delay for idle/no-payload 1403 sessions (adaptive)."
                },
                "gpl.hover.enabled": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Enable GPL language hover (symbol info popup). Built-in editor.hover.* settings still apply."
                },
                "gpl.hover.docComment": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "summary",
                        "full",
                        "off"
                    ],
                    "enumDescriptions": [
                        "First paragraph only, capped by gpl.hover.docCommentMaxLines (like TypeScript/Pylance).",
                        "Entire doc-comment block (still capped by gpl.hover.docCommentMaxLines unless 0).",
                        "Hide doc comments in hover."
                    ],
                    "default": "summary",
                    "description": "How much of a symbol's leading ' doc-comment block to show in hover."
                },
                "gpl.hover.docCommentMaxLines": {
                    "scope": "window",
                    "type": "number",
                    "default": 6,
                    "description": "Max doc-comment lines shown in hover (0 = unlimited). Truncation is marked with '…'."
                },
                "gpl.hover.duringDebug": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "compact",
                        "off",
                        "normal"
                    ],
                    "enumDescriptions": [
                        "Signature-only one-liner while a brooks-gpl debug session is active (keeps variable-value hover uncluttered).",
                        "Suppress language hover entirely while debugging.",
                        "Same hover as when editing."
                    ],
                    "default": "compact",
                    "description": "Language hover behavior while a brooks-gpl debug session is active."
                },
                "gpl.deploy.jumpToFirstError": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "On compile failure during Deploy/Build, open the first compile error's file at its line and reveal the Problems panel."
                },
                "gpl.controller.ip": {
                    "scope": "window",
                    "type": "string",
                    "default": "192.168.0.1",
                    "description": "Brooks controller IP address."
                },
                "gpl.controller.port": {
                    "scope": "window",
                    "type": "number",
                    "default": 1402,
                    "description": "Controller console port (TCP command interface)."
                },
                "gpl.controller.consolePort": {
                    "scope": "window",
                    "type": "number",
                    "default": 1403,
                    "description": "Controller GDE output/event stream port used by this extension (observed runtime console behavior)."
                },
                "gpl.controller.preferIPv4": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Prefer IPv4 when connecting to controller ports (1402/1403) to avoid address-family issues in some environments."
                },
                "gpl.controller.timeoutMs": {
                    "scope": "window",
                    "type": "number",
                    "default": 10000,
                    "description": "Command timeout in milliseconds."
                },
                "gpl.controller.requireStartConfirmation": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Start 명령(프로그램 실행 — 로봇 모션 가능) 전에 확인 모달을 표시합니다. GPL: Start 버튼과 디버그 attach 후 자동 Start에 적용됩니다."
                },
                "gpl.controller.syncEditorBreakpoints": {
                    "scope": "window",
                    "type": "boolean",
                    "default": false,
                    "description": "에디터 중단점 변경(추가/제거/활성 토글)을 연결된 제어기에 즉시 Set Break/Nobreak로 반영합니다. VS Code 중단점이 단일 원본이 됩니다. brooks-gpl 디버그 세션 중에는 DAP가 동기화를 담당하므로 개입하지 않습니다. 외부 AI(MCP)가 실행을 제어하는 워크플로에서 켜면 편리합니다."
                },
                "gpl.controller.autoShowPausedLocation": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "디버그 세션이 없을 때 스레드가 정지(Paused/Break/Error)로 전이하면 정지 위치 파일을 자동으로 열어 표시합니다. 외부 AI(MCP)나 GDE가 세운 정지를 에디터가 따라가는 용도입니다."
                },
                "gpl.controller.ftpBasePath": {
                    "scope": "window",
                    "type": "string",
                    "default": "/GPL",
                    "description": "FTP base path on the controller for project uploads."
                },
                "gpl.controller.ftpFlashProjectsPath": {
                    "scope": "window",
                    "type": "string",
                    "default": "/flash/projects",
                    "description": "FTP path for controller projects stored under flash/projects."
                },
                "gpl.controller.ftpRunLoadBeforeCompile": {
                    "scope": "window",
                    "type": "boolean",
                    "default": false,
                    "description": "Run Load <resolved FTP project path> before FTP Run compile. Disabled by default to avoid unnecessary controller path/load side effects."
                },
                "gpl.controller.threadPollIntervalMs": {
                    "scope": "window",
                    "type": "number",
                    "default": 5000,
                    "description": "Thread status polling interval in milliseconds."
                },
                "gpl.debug.confirmDestructiveRepl": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "디버그 콘솔에서 '>' 접두사로 보내는 명령이 제어기 상태를 바꿀 수 있으면(Start/Stop/Execute/Set 등) 전송 전 확인을 요구합니다."
                },
                "gpl.diagnostics.experimental": {
                    "scope": "window",
                    "type": "boolean",
                    "default": false,
                    "description": "실험적 GPL 정적 진단(XML/성능/호환성 검출)을 활성화합니다. 기본 비활성."
                },
                "gpl.debug.showValueOnCursorClick": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "디버그 중 마우스 클릭으로 커서를 변수 위에 놓으면 디버그 호버(변수 값)를 즉시 표시합니다. 호버 대기시간 없이 바로 값을 확인할 수 있습니다."
                },
                "gpl.controller.dashboardPollIntervalMs": {
                    "scope": "window",
                    "type": "number",
                    "default": 1500,
                    "minimum": 500,
                    "description": "제어기 대시보드 실시간 상태 폴링 주기(ms). 최소 500."
                },
                "gpl.quickCompile.autoOnSave": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "auto",
                        "on",
                        "off"
                    ],
                    "enumDescriptions": [
                        "조건 충족 시에만 자동 실행(기본): /GPL/<프로젝트>가 이미 존재하면 저장 파일을 업로드하고, Compile은 제어기가 완전 STOP 상태(쓰레드가 하나도 없음)일 때만 수행합니다. 쓰레드가 있으면 업로드만 하고 Compile은 보류해 트리·상태바에 '컴파일 필요'로 표시합니다. /GPL 폴더 없음·디버그 세션 중에는 팝업 없이 조용히 건너뜁니다.",
                        "항상 시도(구 true): 게이트 없이 저장마다 실행합니다. 활성 쓰레드가 있으면 조용히 중단하고, /GPL 폴더가 없으면 classic(/flash) 경로로 폴백합니다.",
                        "사용 안 함(구 false)."
                    ],
                    "default": "auto",
                    "description": ".gpl 파일을 저장할 때 빠른 컴파일(변경분 업로드 + Compile, STOP/START 생략)을 자동 실행합니다. 제어기에 연결되어 있을 때만 동작하며 600ms 디바운스가 적용됩니다. 업로드 도중 Compile/Start가 겹치면 제어기 이상이 생길 수 있어 배포 잠금(다른 창·MCP 포함)으로 차단하며, 기본값 \"auto\"는 업로드는 항상 하되 Compile은 완전 STOP 상태에서만 수행합니다. (구버전 boolean 값도 인식: true=on, false=off)"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run bundle:mcp",
        "compile": "tsc -p ./",
        "bundle:mcp": "node scripts/bundle-mcp.js",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node ./out/test/index.js",
        "pre-release-check": "node scripts/pre-release-check.js",
        "git:unlock": "node scripts/git-unlock.js",
        "package": "node scripts/package.js --bump patch",
        "package:no-bump": "node scripts/package.js",
        "dev:cycle": "npm run package",
        "dev:install": "node -e \"console.error('dev:install is disabled to prevent opening new VS Code windows. Build VSIX with npm run dev:cycle, then install manually from Extensions > Install from VSIX.'); process.exit(1);\"",
        "dev:cycle:open": "node -e \"console.error('dev:cycle:open is disabled to prevent opening new VS Code windows. Use npm run dev:install only when explicit reinstall is needed.'); process.exit(1);\"",
        "dev:host": "node -e \"console.error('dev:host is disabled to prevent opening new VS Code windows.'); process.exit(1);\"",
        "dev:watch": "npm run watch",
        "docs:serve": "mkdocs serve",
        "docs:build": "mkdocs build --strict"
    },
