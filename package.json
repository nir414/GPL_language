{
    "name": "gpl-language-support",
    "displayName": "GPL Language Support",
    "description": "GPL (Guidance Programming Language) support for Visual Studio Code - IntelliSense, Go to Definition, Find References for Brooks Automation robot control language",
    "version": "0.8.17",
    "publisher": "nir414",
    "repository": {
        "type": "git",
        "url": "https://github.com/nir414/GPL_language"
    },
    "bugs": {
        "url": "https://github.com/nir414/GPL_language/issues"
    },
    "homepage": "https://github.com/nir414/GPL_language#readme",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers"
    ],
    "keywords": [
        "gpl",
        "guidance programming language",
        "brooks automation",
        "robot control",
        "motion control",
        "automation",
        "preciseflex",
        "vb.net"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:gpl",
        "onView:gplThreads",
        "onCommand:gpl.refreshSymbols",
        "onCommand:gpl.debugSymbolCache",
        "onCommand:gpl.showXmlBestPractices",
        "onCommand:gpl.analyzeXmlEncoding",
        "onCommand:gpl.controller.showDashboard",
        "onCommand:gpl.controller.connect",
        "onCommand:gpl.stopAll",
        "onCommand:gpl.controller.disconnect",
        "onCommand:gpl.deploy",
        "onCommand:gpl.start",
        "onCommand:gpl.saveToFlash",
        "onCommand:gpl.quickCompile",
        "onCommand:gpl.debug.generateLaunch",
        "onCommand:gpl.debug.attachNow",
        "onCommand:gpl.console.start",
        "onCommand:gpl.console.stop",
        "onCommand:gpl.console.ensure",
        "onCommand:gpl.logs.liveTerminal.start",
        "onCommand:gpl.logs.liveTerminal.stop",
        "onCommand:gpl.threads.refresh",
        "onCommand:gpl.controller.pushBreakpoints",
        "onCommand:gpl.controller.pullBreakpoints",
        "onCommand:gpl.controller.refreshBreakpoints",
        "onCommand:gpl.ai.exportAgentSetup",
        "onCommand:gpl.ai.debugAssist",
        "onCommand:gpl.ai.debug.getState",
        "onCommand:gpl.ai.debug.setBreakpoint",
        "onCommand:gpl.ai.debug.clearBreakpoint",
        "onCommand:gpl.ai.debug.breakThread",
        "onCommand:gpl.ai.debug.stepThread",
        "onCommand:gpl.ai.debug.continueThread",
        "onCommand:gpl.ai.debug.evaluate",
        "onCommand:gpl.ai.debug.loop",
        "onCommand:gpl.diagnosticSnapshot",
        "onDebugResolve:brooks-gpl"
    ],
    "contributes": {
        "languages": [
            {
                "id": "gpl",
                "aliases": [
                    "GPL",
                    "gpl"
                ],
                "extensions": [
                    ".gpl",
                    ".gpo"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "gpl",
                "scopeName": "source.gpl",
                "path": "./syntaxes/gpl.tmGrammar.json"
            }
        ],
        "breakpoints": [
            {
                "language": "gpl"
            }
        ],
        "debuggers": [
            {
                "type": "brooks-gpl",
                "languages": [
                    "gpl"
                ],
                "label": "GPL Debug",
                "configurationAttributes": {
                    "attach": {
                        "properties": {
                            "controllerIp": {
                                "type": "string",
                                "description": "Brooks controller IP address (defaults to gpl.controller.ip setting)",
                                "default": ""
                            },
                            "controllerPort": {
                                "type": "number",
                                "description": "Controller TCP command port (defaults to gpl.controller.port setting)",
                                "default": 1402
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Break all threads on attach",
                                "default": false
                            },
                            "projectName": {
                                "type": "string",
                                "description": "GPL project name on the controller (auto-detected from Project.gpr if omitted)",
                                "default": ""
                            },
                            "deployBeforeAttach": {
                                "type": "boolean",
                                "description": "Deploy (UPLOAD ∥ STOP → COMPILE) before attaching debugger.",
                                "default": false
                            },
                            "projectDir": {
                                "type": "string",
                                "description": "Local project directory path used when deployBeforeAttach is true.",
                                "default": ""
                            },
                            "skipUnchangedOnDeploy": {
                                "type": "boolean",
                                "description": "When deployBeforeAttach is true, skip unchanged files during FTP upload.",
                                "default": false
                            },
                            "stopAllBeforeAttach": {
                                "type": "boolean",
                                "description": "Run Stop -all before attaching to avoid unrelated running threads.",
                                "default": false
                            },
                            "clearProjectBreakpointsOnAttach": {
                                "type": "boolean",
                                "description": "Clear existing controller breakpoints for the target project before attaching. Prevents breakpoint duplication across restarts.",
                                "default": true
                            },
                            "stopAllOnDisconnect": {
                                "type": "boolean",
                                "description": "Stop the controller program (Stop -all) when the debug session ends/detaches. Default false leaves the program running.",
                                "default": false
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "brooks-gpl",
                        "request": "attach",
                        "name": "Attach to GPL Controller"
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "GPL Debug: Attach to Controller",
                        "description": "Attach to a Brooks controller for GPL debugging",
                        "body": {
                            "type": "brooks-gpl",
                            "request": "attach",
                            "name": "Attach to GPL Controller",
                            "deployBeforeAttach": false,
                            "stopAllBeforeAttach": false,
                            "clearProjectBreakpointsOnAttach": true,
                            "projectName": ""
                        }
                    },
                    {
                        "label": "GPL Debug: Fast (Stop→Start→Attach, no upload, stop on exit)",
                        "description": "autoOnSave가 업로드를 처리하는 경우용. 업로드 없이 Stop-all→Start→Attach로 빠르게 붙고, 세션 종료 시 프로그램을 정지한다.",
                        "body": {
                            "type": "brooks-gpl",
                            "request": "attach",
                            "name": "Fast Debug (no upload)",
                            "projectName": "MergeCode",
                            "deployBeforeAttach": false,
                            "stopAllBeforeAttach": true,
                            "stopAllOnDisconnect": true,
                            "clearProjectBreakpointsOnAttach": true,
                            "stopOnEntry": false
                        }
                    }
                ]
            }
        ],
        "commands": [
            {
