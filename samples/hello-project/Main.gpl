' hello-project — 한 파일로 둘러보는 GPL 확장 기능.
' 함수 이름에 F12·Shift+F12·F2, 괄호 안에서 Ctrl+Shift+Space를 눌러 본다.

Module Main

    ' 두 정수를 더한다.
    '
    ' # Parameters
    ' - `a`: 첫 번째 값
    ' - `b`: 두 번째 값
    Public Function Add(a As Integer, b As Integer) As Integer
        Return a + b
    End Function

    ' 값을 지정한 범위로 제한한다.
    '
    ' # Parameters
    ' - `value`: 제한할 값
    ' - `min`: 최솟값
    ' - `max`: 최댓값
    '
    ' # Returns
    ' 범위가 적용된 값
    '
    ' # Examples
    ' ```
    ' Clamp(120, 0, 100) ' 결과: 100
    ' ```
    Public Function Clamp(value As Integer, min As Integer, max As Integer) As Integer
        If value < min Then
            Return min
        ElseIf value > max Then
            Return max
        End If
        Return value
    End Function

    ' 객체 멤버 완성과 Property를 확인하는 작은 카운터.
    Public Class Counter
        Private current As Integer

        Public ReadOnly Property Count As Integer
            Get
                Return current
            End Get
        End Property

        Public Sub Increment()
            current = current + 1
        End Sub
    End Class

    ' 계산과 콘솔 출력 후 종료한다.
    Public Sub Main()
        Dim counter As New Counter
        Dim i As Integer
        Dim total As Integer

        total = Add(1, 2)
        For i = 1 To 3
            counter.Increment()
        Next i

        Console.WriteLine("sum: " & CStr(total))
        Console.WriteLine("clamped: " & CStr(Clamp(120, 0, 100)))
        Console.WriteLine("count: " & CStr(counter.Count))
    End Sub

End Module
